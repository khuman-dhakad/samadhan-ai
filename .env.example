# ==============================================================================
# Samadhan AI - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side AI Configuration (DO NOT prefix with VITE_ in production)
# Read by Vercel Serverless Functions (/api/analyze-issue) and Vite dev middleware.
# NEVER expose this key in client-side bundles.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Firebase Web Client Configuration (Vite client-side variables)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 3. Cloudinary Media Storage
# Unsigned upload preset created in Cloudinary Console -> Settings -> Upload -> Upload presets
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ------------------------------------------------------------------------------
# 4. Administrator Access (Development / UI Preview Fallback)
# Production security is enforced in Firestore rules via Firebase Custom Claims (admin: true).
# This variable provides a comma-separated list of emails for local prototyping.
# ------------------------------------------------------------------------------
VITE_ADMIN_EMAILS=admin@samadhan.ai,officer@municipal.gov
